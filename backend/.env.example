# Backend environment variables
# Copy this file to .env and fill in the values for your environment.

# Port the Express server listens on
PORT=3001

# Redis connection string (takes priority over REDIS_HOST/REDIS_PORT)
# Docker Compose local dev:  redis://redis:6379
# Railway managed Redis:     set this to the Railway-provided connection string
# Manual local run:          redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379

# Origin of the frontend — used for CORS and Socket.IO
# Local dev (Docker Compose): http://localhost:8080
# Production (Railway):       https://your-frontend.up.railway.app
FRONTEND_URL=http://localhost:8080

# Optional: override the admin key used to protect /api/admin/* routes
# ADMIN_KEY=supersecret
