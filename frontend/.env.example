# Frontend environment variables (Vite)
# Copy this file to .env and fill in the values for your environment.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.

# Full URL of the backend API / Socket.IO server
# Local dev (Docker Compose): http://localhost:3001
# Production (Railway):       https://your-backend.up.railway.app
VITE_API_URL=http://localhost:3001
